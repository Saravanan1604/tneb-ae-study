{"1431":["<h4 style=\"color:#1a3a8f;font-size:1.75em;font-weight:700\">CLASSIFICATION TREES</h4><h4 style=\"color:#d32f2f;font-size:1.36em;font-weight:700\">SEE THE WHOLE FAMILY IN ONE PICTURE</h4><h4 style=\"font-size:1.75em;font-weight:700\">Classification of electrical machines</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#12304d;border-color:#12304d\">Electrical Machines</span><ul><li><span class=\"tn dk\" style=\"background:#1565c0;border-color:#1565c0\">DC Machines</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">DC Motors</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Series motor</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Shunt motor</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Compound motor</span></li></ul></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">DC Generators</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Separately excited</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Series generator</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Shunt generator</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Compound generator</span></li></ul></li></ul></li><li><span class=\"tn dk\" style=\"background:#1565c0;border-color:#1565c0\">AC Machines</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Induction motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Squirrel cage</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Slip ring (wound)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">1-φ induction</span></li></ul></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Synchronous</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Alternator</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Synchronous motor</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Sync. condenser</span></li></ul></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Transformer (static)</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">1-φ transformer</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">3-φ transformer</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1565c0\">Auto-transformer</span></li></ul></li></ul></li></ul></li></ul><h4 style=\"color:#0d47a1;font-size:1.75em;font-weight:700\">Special machines</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#0d47a1;border-color:#0d47a1\">Special Machines</span><ul><li><span class=\"tn dk\" style=\"background:#1e88e5;border-color:#1e88e5\">Stepper motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1e88e5\">Step angle β = 360°/(m·Nr)</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#1e88e5;border-color:#1e88e5\">BLDC motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1e88e5\">Electronic commutation</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#1e88e5;border-color:#1e88e5\">Servo motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1e88e5\">Position control</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#1e88e5;border-color:#1e88e5\">Universal motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1e88e5\">Runs on AC &amp; DC</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#1e88e5;border-color:#1e88e5\">Reluctance motor</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#1e88e5\">No field winding</span></li></ul></li></ul></li></ul><h4 style=\"font-size:1.75em;font-weight:700\">Power electronic converters</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#4a148c;border-color:#4a148c\">Power Converters</span><ul><li><span class=\"tn dk\" style=\"background:#8e24aa;border-color:#8e24aa\">AC → DC Rectifier</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Uncontrolled (diode)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Half-controlled</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Fully controlled (SCR)</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#8e24aa;border-color:#8e24aa\">DC → DC Chopper</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Buck (step-down)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Boost (step-up)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Buck-boost</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#8e24aa;border-color:#8e24aa\">DC → AC Inverter</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Voltage source (VSI)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Current source (CSI)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">PWM inverter</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#8e24aa;border-color:#8e24aa\">AC → AC</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">AC voltage controller</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#8e24aa\">Cycloconverter (f change)</span></li></ul></li></ul></li></ul>",[]],"1432":["<h4 style=\"color:#b71c1c;font-size:1.54em;font-weight:700\">Protective relays</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#b71c1c;border-color:#b71c1c\">Protective Relays</span><ul><li><span class=\"tn dk\" style=\"background:#e53935;border-color:#e53935\">By construction</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Electromagnetic attraction</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Electromagnetic induction</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Static</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Numerical</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#e53935;border-color:#e53935\">By function</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Over-current: instantaneous, IDMT, directional</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Distance: impedance, reactance, mho</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Differential: simple, % (biased)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Buchholz (transformer gas)</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#e53935;border-color:#e53935\">Which line?</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Short line → reactance</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Medium line → impedance</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#e53935\">Long line → mho</span></li></ul></li></ul></li></ul><h4 style=\"color:#004d40;font-size:1.54em;font-weight:700\">Measuring instruments</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#004d40;border-color:#004d40\">Instruments</span><ul><li><span class=\"tn dk\" style=\"background:#00897b;border-color:#00897b\">Absolute</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Tangent galvanometer</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Rayleigh current balance</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#00897b;border-color:#00897b\">Secondary</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Indicating</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">PMMC — DC only</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Moving iron — AC &amp; DC</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Dynamometer — AC &amp; DC</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Induction — AC only</span></li></ul></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Recording</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Chart recorders</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">X-Y recorder</span></li></ul></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Integrating</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Energy meter (kWh)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#00897b\">Ampere-hour meter</span></li></ul></li></ul></li></ul></li></ul>",[]],"1433":["<h4 style=\"color:#e65100;font-size:1.54em;font-weight:700\">Power generation</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#e65100;border-color:#e65100\">Power Generation</span><ul><li><span class=\"tn\" style=\"background:#fb8c00;border-color:#fb8c00\">Conventional</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Thermal (coal) — base load</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Hydro — peak load, fast start</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Nuclear — base load</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Gas turbine — peak load</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Diesel — standby</span></li></ul></li><li><span class=\"tn\" style=\"background:#fb8c00;border-color:#fb8c00\">Non-conventional (renewable)</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Solar PV</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Wind</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Tidal &amp; wave</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Geothermal</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#fb8c00\">Biomass</span></li></ul></li></ul></li></ul><h4 style=\"color:#37474f;font-size:1.54em;font-weight:700\">Circuit breakers</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#37474f;border-color:#37474f\">Circuit Breakers</span><ul><li><span class=\"tn dk\" style=\"background:#546e7a;border-color:#546e7a\">By arc-quenching medium</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">Air-break — LV/MV</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">Oil — bulk &amp; minimum oil</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">Air-blast — EHV, fast reclosing</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">SF₆ — electronegative gas</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">Vacuum — up to 33 kV</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#546e7a;border-color:#546e7a\">Low-voltage devices</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">MCB — overload &amp; short circuit</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">MCCB — larger currents</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">ELCB / RCCB — earth leakage</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#546e7a\">HRC fuse — heavy short circuits</span></li></ul></li></ul></li></ul>",[]],"1434":["<h4 style=\"font-size:1.54em;font-weight:700\">Thyristor commutation</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#4a148c;border-color:#4a148c\">Commutation</span><ul><li><span class=\"tn dk\" style=\"background:#7b1fa2;border-color:#7b1fa2\">Natural (line)</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class F — AC supply reverses the current</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Used in rectifiers, AC controllers, cycloconverters</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#7b1fa2;border-color:#7b1fa2\">Forced</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class A — load (resonant) commutation</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class B — resonant-pulse (LC) commutation</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class C — complementary (second SCR)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class D — impulse (auxiliary SCR)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#7b1fa2\">Class E — external pulse source</span></li></ul></li></ul></li></ul><h4 style=\"color:#b71c1c;font-size:1.54em;font-weight:700\">Power system studies</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#b71c1c;border-color:#b71c1c\">Power System</span><ul><li><span class=\"tn dk\" style=\"background:#c62828;border-color:#c62828\">Faults</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Symmetrical: LLL, LLLG (rare, most severe)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Unsymmetrical: LG (most common), LL, LLG</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Open conductor</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#c62828;border-color:#c62828\">Load-flow buses</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Slack: |V| and δ given</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">PV (generator): P and |V| given</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">PQ (load): P and Q given</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#c62828;border-color:#c62828\">Stability</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Steady-state — slow, small changes</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Transient — large disturbance, first swing</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#c62828\">Dynamic — with controls (AVR, governor)</span></li></ul></li></ul></li></ul>",[]],"1435":["<h4 style=\"color:#1b5e20;font-size:1.54em;font-weight:700\">Single-phase motors and solar cells</h4><ul class=\"tree\"><li><span class=\"tn dk\" style=\"background:#1b5e20;border-color:#1b5e20\">Machines &amp; cells</span><ul><li><span class=\"tn dk\" style=\"background:#2e7d32;border-color:#2e7d32\">1-φ induction motors</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Split-phase (resistance start)</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Capacitor-start</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Capacitor-start capacitor-run</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Permanent split capacitor</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Shaded-pole</span></li></ul></li><li><span class=\"tn dk\" style=\"background:#2e7d32;border-color:#2e7d32\">Solar PV cells</span><ul><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Mono-crystalline Si — highest efficiency</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Poly-crystalline Si</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Thin film: a-Si, CdTe, CIGS</span></li><li><span class=\"tn\" style=\"background:#ffffff;border-color:#2e7d32\">Multi-junction (GaAs) — space</span></li></ul></li></ul></li></ul>",[]]}